HTTP_ADDRESS=:8081
APP_ENV=development
ALLOW_DESTRUCTIVE_DB_COMMANDS=false

POSTGRES_PORT=5433
POSTGRES_DB=persona_apps
POSTGRES_USER=persona_apps
POSTGRES_PASSWORD=persona_apps
DATABASE_URL=postgres://persona_apps:persona_apps@localhost:5433/persona_apps?sslmode=disable

# Local development uses `make dev-oidc` on port 7071. Replace values outside
# local development; staging and production require deployment-specific secrets.
OIDC_ISSUER_URL=http://localhost:7071
OIDC_CLIENT_ID=persona-operations
OIDC_CLIENT_SECRET=local-development-secret
OIDC_REDIRECT_URL=http://localhost:5174/api/operations/v1/auth/callback
OIDC_PERMISSION_CLAIM=permissions
OPERATIONS_WEB_ORIGIN=http://localhost:5174
OPERATIONS_ALLOWED_ORIGINS=http://localhost:5174
STOREFRONT_ALLOWED_ORIGINS=
AUTH_COOKIE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
IDEMPOTENCY_RESPONSE_KEYS=local:replace-with-base64-32-byte-key
OPERATIONS_SESSION_MAX_LIFETIME=8h

# Guest catalogue abuse control. The limiter is process-local; configure an
# exact proxy CIDR only when a trusted reverse proxy supplies forwarded IPs.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
PUBLIC_RATE_LIMIT_BURST=20
TRUSTED_PROXY_CIDRS=

# Optional private evidence storage. Empty disables only payment evidence upload
# and download. Use an existing owner-private directory outside this checkout.
EVIDENCE_STORAGE_ROOT=
EVIDENCE_STORAGE_MODE=
API_REPLICA_COUNT=

# Empty means browser requests use same-origin canonical paths such as
# /api/public/v1/.... API_PROXY_TARGET is server-only local routing config.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8081
# Set to development to use the non-authoritative local diagnostic adapter.
NEXT_PUBLIC_API_PROVIDER=api
